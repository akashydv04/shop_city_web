## Development defaults. Copy to .env.dev.local (local files are ignored).
VITE_APP_ENV=dev
VITE_API_BASE_URL=
# When VITE_API_BASE_URL is set, account auth uses /api/auth/register, /api/auth/login,
# /api/auth/me, and /api/auth/logout. Tokens are returned by the API and stored only
# in the browser; never put credentials, API keys, or tokens in this file.
# In dev only, the login screen also exposes the seeded /api/auth/dev-login fallback.
VITE_ALLOW_DEMO_FALLBACK=true
